#!/usr/bin/env bash
# The one way to run a Blender script in this repo: pinned binary, no UI,
# no user preferences or add-ons, no network, non-zero exit on any exception.
# Usage: tools/bl <script.py> [script args...]
# KILN_BLENDER_THREADS=<n> limits this Blender to n threads (default: every core). tests/run.sh
# sets it to run several side by side. What a script writes can depend on it: a bake, and a
# file written with tangents, gave the same bytes every time only with one thread. Kiln's
# stages always set it to 1.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
script="$1"; shift
export BLENDER_USER_RESOURCES="$root/.blender-user"
mkdir -p "$BLENDER_USER_RESOURCES"
exec "$root/.tools/blender/blender" --background --factory-startup --offline-mode --quiet \
  ${KILN_BLENDER_THREADS:+--threads "$KILN_BLENDER_THREADS"} --python-exit-code 1 --python "$script" -- "$@"
